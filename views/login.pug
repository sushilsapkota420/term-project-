extends layout

block content
  section.auth-page
    .auth-card
      span.eyebrow Account
      h2 Welcome back
      p Sign in to continue. This is a mock login for this phase.

      form.auth-form(action="/login", method="POST")
        label(for="username") Username
        input#username(type="text", name="username", placeholder="Enter your username", required)

        label(for="password") Password
        input#password(type="password", name="password", placeholder="Enter your password", required)

        button.btn.btn-primary(type="submit") Log In

      .auth-alt
        p Don’t have an account?
        a(href="/register") Create a new account