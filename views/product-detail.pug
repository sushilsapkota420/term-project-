extends layout

block content
  section.detail-card
    span.eyebrow Product Details
    h2= product.name
    p.detail-price $#{product.price.toFixed(2)}

    .detail-list
      .detail-row
        span Product ID
        strong= product.id

      .detail-row
        span Theme
        strong= product.theme

      .detail-row
        span Stock
        strong #{product.stock} available

    .button-row
      a.btn.btn-primary(href="/products") Back to Products
      a.btn.btn-secondary(href="/cart") View Cart