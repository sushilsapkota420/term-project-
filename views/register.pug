extends layout

block content
  section.auth-page
    .auth-card
      span.eyebrow New Account
      h2 Create your account
      p This is a mock registration form. Real account storage comes later.

      form.auth-form(action="/register", method="POST")
        label(for="name") Full Name
        input#name(type="text", name="name", placeholder="Enter your full name", required)

        label(for="username") Username
        input#username(type="text", name="username", placeholder="Choose a username", required)

        label(for="email") Email
        input#email(type="email", name="email", placeholder="Enter your email", required)

        label(for="password") Password
        input#password(type="password", name="password", placeholder="Create a password", required)

        button.btn.btn-primary(type="submit") Create Account

      .auth-alt
        p Already have an account?
        a(href="/login") Log in