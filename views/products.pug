extends layout

block content
  section.page-heading
    span.section-tag Catalog
    h2 Our Mystery Boxes
    p Browse all available mystery boxes in our collection.

  .product-grid
    each product in products
      article.product-card
        .product-card-top
          span.product-theme= product.theme
          span.stock-badge In Stock: #{product.stock}
        h3= product.name
        p.product-id ID: #{product.id}
        p.product-price $#{product.price.toFixed(2)}
        a.btn.btn-primary(href=`/products/${product.id}`) View Details