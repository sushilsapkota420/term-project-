doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || "Mystery Box Store"
    link(rel="stylesheet", href="/css/style.css")

  body
    header.site-header
      .container.navbar
        a.brand(href="/")
          .brand-icon 🎁
          .brand-copy
            h1 Mystery Box Store
            p Premium surprise boxes

        nav.nav-menu
          a(href="/") Home
          a(href="/products") Products
          a(href="/cart") Cart
          a(href="/login") Login
          a(href="/profile") Profile

    main.page-shell
      .container
        block content

    footer.site-footer
      .container.footer-grid
        div
          h2 Mystery Box Store
          p CSC 317 Group Project
          p Bigyan Shrestha & Sushil Sapkota © #{currentYear}
        div
          h3 Quick Links
          a(href="/products") Products
          a(href="/cart") Cart
          a(href="/login") Login